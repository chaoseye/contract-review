# Настройки машины для contract-review. Всё остальное настраивается в админке и хранится в базе.
# Создать .env со случайными секретами: python deploy/scripts/init_env.py
# Файл .env в git не попадает.

# Адрес, по которому пользователи открывают систему. С https:// cookie входа получают флаг Secure.
PUBLIC_URL=http://localhost:8080

# На каком интерфейсе и порту хоста слушает приложение.
# 127.0.0.1 — только с этой машины (и для Caddy на сервере); 0.0.0.0 — из локальной сети.
APP_BIND=127.0.0.1
APP_PORT=8080

# Пароль базы PostgreSQL (используется только внутри docker compose).
POSTGRES_PASSWORD=change-me

# Секрет для токенов сессий: случайная строка от 32 символов. Смена разлогинит всех.
APP_SECRET_KEY=change-me

# Ключ шифрования ключей подключений ИИ (Fernet, 32 байта в base64url). Без него ключ API не сохранить.
# Смена ключа сделает сохранённые ключи ИИ нечитаемыми — их придётся ввести заново.
ENCRYPTION_KEY=

# Codex CLI в образе: анализ по подписке ChatGPT без ключа API. true — образ собирается с Codex
# при каждом docker compose build и up --build. Вход — «Подключения ИИ» → «Войти по коду».
INSTALL_CODEX=false

# Путь к Codex CLI, если он не в PATH (только для запуска без Docker; в образе с INSTALL_CODEX=true не нужен).
# На Windows после npm install -g @openai/codex достаточно значения по умолчанию: система найдёт codex.exe.
# CODEX_BIN=codex

# Первый администратор. Создаётся при запуске, только если в базе ещё нет пользователей.
# Пароль — от 8 символов. После первого входа его можно убрать из .env.
INITIAL_ADMIN_LOGIN=admin
INITIAL_ADMIN_PASSWORD=

# Срок сессии без активности, часов.
SESSION_TTL_HOURS=12

# Сколько часов после последнего действия хранится проверка договора, потом удаляется целиком.
# Значение по умолчанию: администратор может задать своё в разделе «Настройки» админки.
CHECK_TTL_HOURS=24

# Максимальный размер загружаемого договора, МБ. Тоже значение по умолчанию до настройки в админке.
MAX_UPLOAD_MB=50

# Сколько фоновых задач worker выполняет одновременно.
WORKER_CONCURRENCY=2

# Подробность логов: DEBUG, INFO, WARNING, ERROR. Тексты договоров в логи не пишутся.
LOG_LEVEL=INFO

# Схема API и Swagger на /api/docs — только для разработки. На сервере оставьте false:
# схема открыта без входа и перечисляет все адреса API, в том числе админки.
API_DOCS=false

# Шифрование резервных копий: открытый ключ age (age1…). backup.py шифрует им каждую копию.
# Закрытый ключ хранится у владельца, на сервер его не кладут. Пусто — копии не шифруются.
BACKUP_AGE_RECIPIENT=

# Только для профиля server: домен для HTTPS (например contracts.example.ru) или IP сервера без https://
# (192.168.1.10, documentation/DEPLOYMENT.md, раздел 3.4).
SITE_ADDRESS=
# Профиль server включает контейнер caddy для всех команд docker compose (documentation/DEPLOYMENT.md, раздел 3.3).
# COMPOSE_PROFILES=server

# Адреса обратного прокси, которому приложение верит в заголовке X-Forwarded-For (адрес клиента нужен
# ограничению попыток входа). По умолчанию 127.0.0.1. Для профиля server — * при APP_BIND=127.0.0.1:
# тогда до приложения доходят только Caddy и сама машина (documentation/DEPLOYMENT.md).
# FORWARDED_ALLOW_IPS=127.0.0.1
